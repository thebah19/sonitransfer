{
  "name": "soni-transfer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
