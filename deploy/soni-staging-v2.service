[Unit]
Description=Soni Transfer V2 staging Next.js app
After=network.target

[Service]
Type=simple
User=madani-webuser
Group=webdev
WorkingDirectory=/var/www/stagging-soni-transfer-com-v2
Environment=NODE_ENV=production
Environment=PORT=3002
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_PUBLIC_BASE_PATH=/v2
Environment=REMITEC_API_BASE_URL=https://app.sonitransfer.com/api
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3002
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/stagging-soni-transfer-com-v2

[Install]
WantedBy=multi-user.target
